APP_ENV=development
APP_NAME=ML Advisor
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_PORT=5173
UI_LANGUAGE=pt-BR
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:8080

DATABASE_URL=sqlite:////data/database/app.db
ARTIFACT_STORAGE=local
ARTIFACT_PATH=/data/experiments
DATASET_PATH=/data/datasets
MAX_UPLOAD_SIZE_MB=50
DATASET_PREVIEW_ROWS=20

AUTH_MODE=disabled

LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
REASONING_MODEL=false
LLM_REASONING=medium
LLM_VERBOSITY=low
OPENROUTER_PROVIDER=
LLM_LANGUAGE=pt-BR
LLM_SEND_SAMPLE=false
LLM_SAMPLE_SIZE=10
LLM_TIMEOUT_SECONDS=60
ADVISOR_PROMPTS_PATH=/app/prompts

DECISION_FEATURES_ENABLED=false
DECISION_PROVIDER=typesafe_jev
DECISION_MODEL=jev-latest
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_REQUEST_TIMEOUT_SECONDS=60
DECISION_MAX_RETRIES=3
DECISION_CONCURRENCY=8
DECISION_CACHE_ENABLED=true
DECISION_EXTERNAL_PROCESSING_ACK_REQUIRED=true

DEFAULT_RANDOM_SEED=41
